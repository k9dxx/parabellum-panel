<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pblm_widget_bg"
    android:gravity="center_vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/pblm_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⛧ PARABELLUM"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#E21D32"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PBLM.777  /  COMUNIDADE"
        android:textSize="10sp"
        android:textColor="#BFAAB5"
        android:paddingBottom="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/pblm_widget_home" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center" android:text="⌂ Início"
            android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/pblm_widget_btn"/>
        <TextView android:id="@+id/pblm_widget_community" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center" android:text="♟ Membros"
            android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/pblm_widget_btn"/>
        <TextView android:id="@+id/pblm_widget_news" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center" android:text="▤ Notícias"
            android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/pblm_widget_btn"/>
    </LinearLayout>
</LinearLayout>
